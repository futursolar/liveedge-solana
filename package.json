{
  "name": "liveedge-solana",
  "version": "0.1.0",
  "private": false,
  "description": "Risk-Gated Impulse Execution Terminal for Solana Perps & Prediction Markets (Pyth Hermes + Drift v2 + Atomic On-Chain Sizing Guard)",
  "type": "module",
  "author": "RedKoi Research",
  "license": "MIT",
  "bin": {
    "liveedge-solana": "./bin/liveedge-solana.mjs"
  },
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build && node ./scripts/build_cli.mjs",
    "preview": "vite preview --port 4174",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "node ./bin/liveedge-solana.mjs",
    "devnet:evidence": "node ./scripts/generate_devnet_evidence.mjs",
    "devnet:broadcast": "node ./scripts/broadcast_devnet_txs.mjs",
    "record:demo": "node ./scripts/record_demo_video.mjs",
    "check:all": "node ./scripts/self_check.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@pythnetwork/hermes-client": "^2.1.0",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.49.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
